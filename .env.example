# Server only. Never expose these to a browser.

# Simpro build name, as in https://<name>.simprosuite.com
SIMPRO_BUILD_NAME=
SIMPRO_COMPANY_ID=0
# Use a dedicated Simpro API login, because Simpro tokens have full access and can't be limited.
SIMPRO_MCP_API_TOKEN=

# At least 32 random characters. Signs plans between planning and applying.
SIMPRO_MCP_PLAN_SECRET=
# JSON of person name to SHA-256 token hash. Create entries with: pnpm new-token "Name"
SIMPRO_MCP_TOKENS={}
# Planning and applying stay off unless this is exactly true.
SIMPRO_MCP_WRITES_ENABLED=false

# Supabase project holding the simpro_mcp_audit table.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
